# ============================================
# SMM Panel Telegram Bot - Konfiguratsiya
# ============================================

# Telegram Bot Token (BotFather dan oling)
BOT_TOKEN=YOUR_BOT_TOKEN_HERE

# Admin Telegram ID lari (vergul bilan ajrating)
ADMIN_IDS=123456789,987654321

# Buyurtmalar yuboriladigan guruh ID si
# (guruhga botni qo'shing, /id buyrug'i bilan ID ni oling)
ORDER_GROUP_ID=-1001234567890

# ============================================
# Database
# ============================================
# SQLite (development uchun — tez ishga tushadi)
DATABASE_URL=sqlite+aiosqlite:///data/smm_bot.db

# PostgreSQL (production uchun — 1M+ foydalanuvchi)
# DATABASE_URL=postgresql+asyncpg://smm_user:smm_password@localhost:5432/smm_bot_db

# ============================================
# Redis (FSM va kesh uchun)
# ============================================
REDIS_URL=redis://localhost:6379/0

# ============================================
# To'lov sozlamalari
# ============================================
MIN_PAYMENT_AMOUNT=5000
REFERRAL_BONUS_PERCENT=5

# 1 Telegram Star = necha so'm
STARS_RATE=1500

# ============================================
# To'lov kartalari
# ============================================
PAYMENT_CARD_CLICK=8600 1234 5678 9012
PAYMENT_CARD_PAYME=8600 1234 5678 9012
PAYMENT_CARD_HOLDER=ISMI FAMILIYASI

# ============================================
# Bot sozlamalari
# ============================================
THROTTLE_RATE=0.5
LOG_LEVEL=INFO
BOT_USERNAME=smm_panel_bot
SUPPORT_USERNAME=admin_username
